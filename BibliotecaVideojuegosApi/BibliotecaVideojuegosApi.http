Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkMTdiYzBlMy1lZjUxLTRkNTYtODVkYy1lMGM4OGM3N2QxZTgiLCJlbWFpbCI6ImRhaWFuYWVsaUBnbWFpbC5jb20iLCJqdGkiOiJkYmJjMDZjMi03MmI5LTQ4YmYtYWMzMS0zMTA3ZDBjOGY1YTQiLCJleHAiOjE3ODk0NTYwMzEsImlzcyI6IkJpYmxpb3RlY2FWaWRlb2p1ZWdvc0FwaSIsImF1ZCI6IkJpYmxpb3RlY2FWaWRlb2p1ZWdvc0FwaSJ9.1W0EpSbjgTYyEERbsLf8aIVrw0yY8lTh3OYl5QP0tGE

{
  "titulo": "Celeste",
  "genero": "Plataformas",
  "plataforma": "PC"
}

### Actualizar un videojuego
PUT {{BibliotecaVideojuegosApi_HostAddress}}/videojuegos/1
Content-Type: application/json

{
  "titulo": "The Legend of Zelda: Breath of the Wild",
  "genero": "Aventura",
  "plataforma": "Switch"
}

### Eliminar un videojuego
DELETE {{BibliotecaVideojuegosApi_HostAddress}}/videojuegos/1

### ============================================================
### BUSQUEDA (paginada) - usa el verbo custom QUERY
### ============================================================

### Buscar videojuegos con filtros y paginación
QUERY {{BibliotecaVideojuegosApi_HostAddress}}/videojuegos/buscar
Content-Type: application/json

{
  "titulo": "Elden Ring",
  "page": 1,
  "pageSize": 10
}

### ============================================================
### COPIAS DE VIDEOJUEGO
### ============================================================

### Obtener todas las copias
GET {{BibliotecaVideojuegosApi_HostAddress}}/copiasvideojuego

### Obtener una copia por Id
GET {{BibliotecaVideojuegosApi_HostAddress}}/copiasvideojuego/1

### Crear una copia (requiere autenticación)
POST {{BibliotecaVideojuegosApi_HostAddress}}/copiasvideojuego
Content-Type: application/json
Authorization: Bearer PEGAR_TOKEN

{
  "videoJuegoId": 1,
  "estadoPrestado": false
}

### Actualizar una copia
PUT {{BibliotecaVideojuegosApi_HostAddress}}/copiasvideojuego/1
Content-Type: application/json

{
  "videoJuegoId": 1,
  "estadoPrestado": false
}

### Eliminar una copia
DELETE {{BibliotecaVideojuegosApi_HostAddress}}/copiasvideojuego/1

### ============================================================
### PRESTAMOS DE VIDEOJUEGO
### ============================================================

### Obtener todos los préstamos
GET {{BibliotecaVideojuegosApi_HostAddress}}/prestamovideojuego

### Obtener un préstamo por Id
GET {{BibliotecaVideojuegosApi_HostAddress}}/prestamovideojuego/1

### Crear un préstamo (requiere autenticación)
POST {{BibliotecaVideojuegosApi_HostAddress}}/prestamovideojuego
Content-Type: application/json
Authorization: Bearer PEGAR_TOKEN

{
  "copiaVideoJuegoId": 1,
  "fechaPrestamo": "2026-01-01T00:00:00Z",
  "nombreUsuario": "Daiana"
}

### Devolver un préstamo
PUT {{BibliotecaVideojuegosApi_HostAddress}}/prestamovideojuego/1/devolver

### Eliminar un préstamo
DELETE {{BibliotecaVideojuegosApi_HostAddress}}/prestamovideojuego/1

### ============================================================
### OTROS
### ============================================================

### Health check
GET {{BibliotecaVideojuegosApi_HostAddress}}/health

### Documento OpenAPI
GET {{BibliotecaVideojuegosApi_HostAddress}}/openapi/v1.json
